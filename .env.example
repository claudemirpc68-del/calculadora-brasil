# ==============================================================================
# TEMPLATE DE VARIÁVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Instruções:
# 1. Copie este arquivo e renomeie-o para ".env" no seu ambiente local.
# 2. O arquivo ".env" é ignorado pelo Git (conforme configurado no .gitignore).
# 3. Nunca comite o arquivo ".env" com valores reais!
# 4. Para produção/staging no Coolify, configure estas variáveis diretamente
#    nas configurações da aplicação (Environment Variables) no painel do Coolify.
# ==============================================================================

# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Configurações de Banco de Dados (Exemplo PostgreSQL/MySQL)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/nome_banco?schema=public

# Configurações de API e Integrações Externas
API_KEY=seu_api_key_aqui
API_BASE_URL=https://api.exemplo.com

# Integração com Coolify (Caso necessário para chamadas de API ou Webhooks)
# COOLIFY_URL=https://sua-instancia-coolify.com
# COOLIFY_API_KEY=sua_chave_de_api_do_coolify
